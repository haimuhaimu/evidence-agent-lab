{
  "name": "evidence-agent-lab",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "engines": { "node": ">=20.9.0" },
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint .",
    "test": "tsx --test src/**/*.test.ts",
    "bench": "tsx scripts/bench.ts",
    "bench:update": "tsx scripts/bench.ts --update",
    "verify": "npm test && npm run lint && npm run build && npm run bench"
  },
  "dependencies": {
    "next": "16.2.10",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "eslint": "^9.34.0",
    "eslint-config-next": "16.2.10",
    "tsx": "^4.20.6",
    "typescript": "^5.9.2"
  }
}
